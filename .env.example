# ─── Database ────────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://kardex:kardex_dev@localhost:5432/kardex_dev

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=changeme_use_long_random_string_in_production

# ─── Seed local ──────────────────────────────────────────────────────────────
# Obligatorios solo al ejecutar `pnpm --filter @kardex/database db:seed`.
# No reutilizar estas contraseñas en otros entornos o servicios.
SEED_ADMIN_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_WAREHOUSE_PASSWORD=

# ─── App ─────────────────────────────────────────────────────────────────────
# URL of the frontend (used for CORS)
APP_URL=http://localhost:5173

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
# Required for password reset and welcome emails
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── GCP (production only) ───────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_SQL_INSTANCE=
